<ButtonConf ButtonName="CREATE CC" Description="Create new cost centre" QuickCommand="CREATE CC">
  <TextBox VarName="cc" Question="Enter the cost centre name" Width="200" ToolTip="">
    <ValidationRules>
      <RegEx ErrorMessage="INVALID NAME"><![CDATA[(^[A-Z, ]+$)]]></RegEx>
    </ValidationRules>
    <DefaultValue>INSERT COST CENTRE NAME</DefaultValue>
  </TextBox>
  <RunCommand StandardCommand="True">CFB/[cc]</RunCommand>
  <RunCommand StandardCommand="True">1N/INSERT BUSINESS NAME HERE</RunCommand>
  <RunCommand StandardCommand="True">2Y/P.LONB*01432123456</RunCommand>
  <RunCommand StandardCommand="True">3Y/MT.TRAVEL@MYDOMAIN.COM</RunCommand>
  <RunCommand StandardCommand="True">4Y/W.FIRSTLINE*SECONDLINE*CITY*GB*P/SW1A 2AA</RunCommand>
  <RunCommand StandardCommand="True">4Y/D.FIRSTLINE*SECONDLINE*CITY*GB*P/SW1A 2AA</RunCommand>
  <RunCommand StandardCommand="True">CE</RunCommand>
  <ShowMessage ShowInTerminal="True" ClearScreen="True">COMPLETE</ShowMessage>
</ButtonConf>