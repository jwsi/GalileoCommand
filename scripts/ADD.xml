<ButtonConf ButtonName="ADD" Description="Add a passenger to a PNR" QuickCommand="ADD">
  <RunCommand StandardCommand="True">CLB</RunCommand>
  <GetString VarName="ccs"><![CDATA[\d+\s+(?!CIDBNUMBER\b)([A-Z]+(?:\s+[A-Z]+)*?)(?=\s{2,}\d+\s+|\s{2,}|END OF DISPLAY|$)]]></GetString>
  <ComboBox VarName="cc" Question="Choose a cost centre" Width="400" ToolTip="Choose a cost centre" ElementsList="[ccs]" Return="Value" Display="Value" SelectedItemIndex="1"></ComboBox>
  <BookingFileBrowser VarName="passenger_count" RefreshBookingFile="False" LoadFiledFaresDetails="False">Passengers.Count</BookingFileBrowser>
  <ArithmeticalOperation VarName="number">[passenger_count]+1</ArithmeticalOperation>
  <RunCommand StandardCommand="True">CLP/[cc]</RunCommand>
  <GetString VarName="names"><![CDATA[\d+\s+([A-Z]+(?:\s+[A-Z]+)+)]]></GetString>
  <ComboBox VarName="name" Question="Choose a passenger" Width="400" ToolTip="Choose a passenger" ElementsList="[names]" Return="Value" Display="Value" SelectedItemIndex="1"></ComboBox>
  <BookingFileBrowser VarName="ccpnrraw" RefreshBookingFile="False" LoadFiledFaresDetails="False">Remarks[0].Text</BookingFileBrowser>
  <ShowMessage ShowInTerminal="True" ClearScreen="True">[ccpnrraw]</ShowMessage>
  <GetString VarName="ccpnr"><![CDATA[COST CENTRE:\s*([A-Z]+(?:\s+[A-Z]+)*)]]></GetString>
  <ConditionalAction Condition="[number]==1">
    <True>
      <RunCommand StandardCommand="True">C*[cc]</RunCommand>
      <RunCommand StandardCommand="True">CM/</RunCommand>
      <RunCommand StandardCommand="True">NP.H**AGYRG-COST CENTRE: [cc]</RunCommand>
    </True>
    <False>
      <ConditionalAction Condition="[cc]==[ccpnr]">
        <True></True>
        <False>
          <ShowMessage ShowInTerminal="True" ClearScreen="True">ONLY ONE COST CENTRE PER PNR IS PERMITTED - TRY AGAIN</ShowMessage>
          <Exit />
        </False>
      </ConditionalAction>
    </False>
  </ConditionalAction>
  <RunCommand StandardCommand="True">C*[cc]-[name]</RunCommand>
  <GetString VarName="title"><![CDATA[10N\/(.*)]]></GetString>
  <GetString VarName="first"><![CDATA[11N\/(.*)]]></GetString>
  <GetString VarName="last"><![CDATA[12N\/(.*)]]></GetString>
  <GetString VarName="middle"><![CDATA[13N\/(.*)]]></GetString>
  <GetString VarName="nationality"><![CDATA[14N\/(.*)]]></GetString>
  <GetString VarName="dob"><![CDATA[15N\/(.*)]]></GetString>
  <GetString VarName="pp_issuer"><![CDATA[16N\/(.*)]]></GetString>
  <GetString VarName="pp_number"><![CDATA[17N\/(.*)]]></GetString>
  <GetString VarName="pp_expiry"><![CDATA[18N\/(.*)]]></GetString>
  <GetString VarName="sex"><![CDATA[19N\/(.*)]]></GetString>
  <GetString VarName="mobile"><![CDATA[20N\/(.*)]]></GetString>
  <GetString VarName="email"><![CDATA[21N\/(.*)]]></GetString>
  <ConditionalAction Condition="[title]==">
    <True>
      <ShowMessage ShowInTerminal="True" ClearScreen="True">FILE DOES NOT EXIST - TRY AGAIN</ShowMessage>
      <Exit />
    </True>
    <False></False>
  </ConditionalAction>
  <JsSnippet VarName="age">
    <Code><![CDATA[
    
    var start = new Date().getTime();
	while (typeof dob == "undefined") {
	    var now = new Date().getTime();
	    if ((now - start) > 3000) {
	    	break;
	    }
	}
    
	birthDate = new Date(dob);
	currentDate = new Date();

	var years = (currentDate.getFullYear() - birthDate.getFullYear());
	
	if (currentDate.getMonth() < birthDate.getMonth() || 
	    currentDate.getMonth() == birthDate.getMonth() && currentDate.getDate() < birthDate.getDate()) {
	    years--;
	}
	
	return years.toLocaleString('en-US', {minimumIntegerDigits: 2, useGrouping:false});
	
	]]></Code>
  </JsSnippet>
  <ConditionalAction Condition="[age]&gt;11">
    <True>
      <RunCommand StandardCommand="True" ClearScreen="False">N.1[last]/[first] [title]</RunCommand>
    </True>
    <False>
      <ConditionalAction Condition="([age] == 00) OR ([age] == 01)">
        <True>
          <RunCommand StandardCommand="True" ClearScreen="False">N.I/1[last]/[first] [title]*[dob]</RunCommand>
        </True>
        <False>
          <RunCommand StandardCommand="True" ClearScreen="False">N.1[last]/[first] [title]*P-C[age] DOB[dob]</RunCommand>
        </False>
      </ConditionalAction>
    </False>
  </ConditionalAction>
  <RunCommand StandardCommand="True">CMP/P-[number]</RunCommand>
  <ConditionalAction Condition="[middle]==">
    <True>
      <RunCommand StandardCommand="True">NP.P[number]/SSRDOCSYYHK1/////[dob]/[sex]//[last]/[first]</RunCommand>
      <RunCommand StandardCommand="True">NP.P[number]/SSRDOCSYYHK1/P/[pp_issuer]/[pp_number]/[nationality]/[dob]/[sex]/[pp_expiry]/[last]/[first]</RunCommand>
    </True>
    <False>
      <RunCommand StandardCommand="True">NP.P[number]/SSRDOCSYYHK1/////[dob]/[sex]//[last]/[first]/[middle]</RunCommand>
      <RunCommand StandardCommand="True">NP.P[number]/SSRDOCSYYHK1/P/[pp_issuer]/[pp_number]/[nationality]/[dob]/[sex]/[pp_expiry]/[last]/[first]/[middle]</RunCommand>
    </False>
  </ConditionalAction>
  <RunCommand StandardCommand="True">NP.P[number]/SSRCTCMYYHK1/[mobile]/EN</RunCommand>
  <RunCommand StandardCommand="True">NP.P[number]/SSRCTCEYYHK1/[email]/EN</RunCommand>
  <ShowMessage ShowInTerminal="True" ClearScreen="True">COMPLETE</ShowMessage>
</ButtonConf>